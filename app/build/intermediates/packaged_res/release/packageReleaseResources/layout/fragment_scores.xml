<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/mlb_navy"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:text="Scores"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Date strip row: Today button + scrollable tabs + calendar button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/date_strip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_header">

        <!-- Today Button — fixed to the left edge -->
        <ImageButton
            android:id="@+id/btn_today"
            android:layout_width="48dp"
            android:layout_height="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Navigate to today"
            android:src="@drawable/ic_refresh"
            android:scaleType="center"
            app:tint="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Thin vertical separator on the left -->
        <View
            android:id="@+id/left_separator"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/surface_elevated"
            app:layout_constraintBottom_toBottomOf="@id/btn_today"
            app:layout_constraintStart_toEndOf="@id/btn_today"
            app:layout_constraintTop_toTopOf="@id/btn_today" />

        <!-- Date tabs RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_date_tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toStartOf="@id/separator"
            app:layout_constraintStart_toEndOf="@id/left_separator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Thin vertical separator on the right -->
        <View
            android:id="@+id/separator"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/surface_elevated"
            app:layout_constraintBottom_toBottomOf="@id/btn_calendar"
            app:layout_constraintEnd_toStartOf="@id/btn_calendar"
            app:layout_constraintTop_toTopOf="@id/btn_calendar" />

        <!-- Calendar button — fixed to the right edge -->
        <ImageButton
            android:id="@+id/btn_calendar"
            android:layout_width="48dp"
            android:layout_height="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open calendar"
            android:src="@drawable/ic_calendar"
            android:scaleType="center"
            app:tint="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divider -->
    <View
        android:id="@+id/date_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/surface_elevated"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/date_strip" />

    <!-- ViewPager for swiping between dates -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/date_divider" />

</androidx.constraintlayout.widget.ConstraintLayout>
