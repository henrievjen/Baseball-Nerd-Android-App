<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/mlb_navy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="14dp"
            android:text="Game Detail"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:clipToPadding="false">

            <!-- ── Score Card ─────────────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <!-- Logo + Inning + Logo row -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="20dp">

                        <FrameLayout
                            android:id="@+id/layout_away_logo"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <View android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@drawable/shape_team_circle" android:backgroundTint="@color/white" />
                            <ImageView android:id="@+id/iv_away_logo"
                                android:layout_width="36dp" android:layout_height="36dp"
                                android:layout_gravity="center" android:scaleType="centerInside" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_inning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:maxLines="1"
                            android:ellipsize="end"
                            app:layout_constraintBottom_toBottomOf="@id/layout_away_logo"
                            app:layout_constraintEnd_toStartOf="@id/layout_home_logo"
                            app:layout_constraintStart_toEndOf="@id/layout_away_logo"
                            app:layout_constraintTop_toTopOf="@id/layout_away_logo"
                            tools:text="Top 3rd" />

                        <FrameLayout
                            android:id="@+id/layout_home_logo"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="28dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <View android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@drawable/shape_team_circle" android:backgroundTint="@color/white" />
                            <ImageView android:id="@+id/iv_home_logo"
                                android:layout_width="36dp" android:layout_height="36dp"
                                android:layout_gravity="center" android:scaleType="centerInside" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_away_record"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toEndOf="@id/layout_away_logo"
                            app:layout_constraintStart_toStartOf="@id/layout_away_logo"
                            app:layout_constraintTop_toBottomOf="@id/layout_away_logo"
                            tools:text="45-32" />

                        <TextView
                            android:id="@+id/tv_home_record"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toEndOf="@id/layout_home_logo"
                            app:layout_constraintStart_toStartOf="@id/layout_home_logo"
                            app:layout_constraintTop_toBottomOf="@id/layout_home_logo"
                            tools:text="42-35" />

                        <TextView
                            android:id="@+id/tv_away_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            app:layout_constraintEnd_toEndOf="@id/layout_away_logo"
                            app:layout_constraintStart_toStartOf="@id/layout_away_logo"
                            app:layout_constraintTop_toBottomOf="@id/tv_away_record"
                            tools:text="4" />

                        <TextView
                            android:id="@+id/tv_home_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            app:cardCornerRadius="28dp"
                            app:layout_constraintEnd_toEndOf="@id/layout_home_logo"
                            app:layout_constraintStart_toStartOf="@id/layout_home_logo"
                            app:layout_constraintTop_toBottomOf="@id/tv_home_record"
                            tools:text="2" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Badge Container -->
                    <LinearLayout
                        android:id="@+id/layout_badges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_playoff_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_no_hitter_badge"
                            android:backgroundTint="@color/mlb_navy"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible"
                            tools:text="WORLD SERIES GAME 1" />

                        <TextView
                            android:id="@+id/tv_game_type_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_no_hitter_badge"
                            android:backgroundTint="@color/text_secondary"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible"
                            tools:text="SPRING TRAINING" />

                        <TextView
                            android:id="@+id/tv_no_hitter_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_no_hitter_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/no_hitter"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tv_perfect_game_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_no_hitter_badge"
                            android:backgroundTint="@color/mlb_gold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/perfect_game"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <!-- Linescore Section -->
                    <LinearLayout
                        android:id="@+id/card_box_score"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:scrollbars="none">

                            <TableLayout
                                android:id="@+id/table_linescore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="16dp" />

                        </HorizontalScrollView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="24dp"
                            android:layout_marginVertical="16dp"
                            android:background="@color/surface_elevated" />
                    </LinearLayout>

                    <!-- Probable Pitchers (Preview only) -->
                    <LinearLayout
                        android:id="@+id/layout_probables"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="12dp"
                        android:visibility="gone">

                        <!-- Away Starter -->
                        <LinearLayout
                            android:id="@+id/layout_away_starter"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true">
                            <androidx.cardview.widget.CardView
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                app:cardCornerRadius="45dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_elevated">
                                <ImageView
                                    android:id="@+id/iv_away_starter"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop" />
                            </androidx.cardview.widget.CardView>
                            <TextView
                                android:id="@+id/tv_away_starter_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                            <TextView
                                android:id="@+id/tv_away_starter_stats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>

                        <!-- VS Middle -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="8dp"
                            android:text="VS"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Home Starter -->
                        <LinearLayout
                            android:id="@+id/layout_home_starter"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true">
                            <androidx.cardview.widget.CardView
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                app:cardCornerRadius="45dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_elevated">
                                <ImageView
                                    android:id="@+id/iv_home_starter"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop" />
                            </androidx.cardview.widget.CardView>
                            <TextView
                                android:id="@+id/tv_home_starter_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                            <TextView
                                android:id="@+id/tv_home_starter_stats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Preview Lineups Section -->
                    <LinearLayout
                        android:id="@+id/layout_preview_lineups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingTop="16dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="24dp"
                            android:background="@color/surface_elevated" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="12dp"
                            android:paddingBottom="4dp"
                            android:text="Probable Lineups"
                            android:gravity="center"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingBottom="8dp">

                            <TableLayout
                                android:id="@+id/table_away_lineup_preview"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginHorizontal="8dp"
                                android:background="@color/surface_elevated" />

                            <TableLayout
                                android:id="@+id/table_home_lineup_preview"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Live Section Container -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <!-- Combined Status, Bases, and Player Info -->
                        <LinearLayout
                            android:id="@+id/layout_live_data"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:paddingHorizontal="16dp"
                            android:gravity="center_vertical">

                            <!-- Left: Strike Zone + Current Pitches -->
                            <LinearLayout
                                android:id="@+id/layout_strike_zone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"
                                android:orientation="vertical"
                                android:visibility="gone"
                                android:gravity="center_horizontal">

                                <com.baseballnerd.app.ui.scores.StrikeZoneView
                                    android:id="@+id/strike_zone_view"
                                    android:layout_width="120dp"
                                    android:layout_height="200dp" />

                                <LinearLayout
                                    android:id="@+id/container_current_pitches"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="vertical" />
                            </LinearLayout>

                            <!-- Center: Bases + Count/Outs -->
                            <LinearLayout
                                android:id="@+id/card_game_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:orientation="vertical"
                                android:visibility="gone"
                                android:gravity="center_horizontal">

                                <com.baseballnerd.app.ui.scores.BaseDiamondView
                                    android:id="@+id/base_view"
                                    android:layout_width="64dp"
                                    android:layout_height="64dp" />

                                <LinearLayout
                                    android:id="@+id/layout_count_outs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.9"
                                    android:orientation="vertical"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_horizontal">
                                    <TextView android:id="@+id/tv_count"
                                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"
                                        tools:text="2 - 1" />
                                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp" android:orientation="horizontal">
                                        <ImageView android:id="@+id/out_1" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="4dp" android:src="@drawable/shape_out_filled" />
                                        <ImageView android:id="@+id/out_2" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="4dp" android:src="@drawable/shape_out_filled" />
                                        <ImageView android:id="@+id/out_3" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/shape_out_filled" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Right: Pitcher / Batter info -->
                            <LinearLayout
                                android:id="@+id/card_player_info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:orientation="vertical"
                                android:visibility="gone"
                                android:paddingStart="8dp"
                                android:paddingEnd="0dp">
                                <TextView android:id="@+id/tv_pitcher_info"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary" android:textSize="12sp" />
                                <TextView android:id="@+id/tv_batter_info"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp" android:textColor="@color/text_primary" android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Batting Lineups / Plays Card ─────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_lineups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Modern Tab Selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_tab_container"
                        android:padding="4dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/btn_lineups"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Lineups"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_tab_selected" />

                        <TextView
                            android:id="@+id/btn_plays"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Plays"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@android:color/transparent" />

                    </LinearLayout>

                    <!-- Lineups Content -->
                    <LinearLayout
                        android:id="@+id/scroll_lineups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Away Section -->
                        <TextView
                            android:id="@+id/tv_away_lineup_team"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/mlb_red"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:paddingBottom="4dp"
                            tools:text="AWAY" />

                        <!-- Batter table scrolls horizontally on its own -->
                        <HorizontalScrollView
                            android:id="@+id/scroll_away_lineup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <TableLayout
                                android:id="@+id/table_away_lineup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </HorizontalScrollView>

                        <!-- Pitcher table scrolls horizontally -->
                        <HorizontalScrollView
                            android:id="@+id/scroll_away_pitchers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:scrollbars="none">

                            <TableLayout
                                android:id="@+id/table_away_pitchers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </HorizontalScrollView>

                        <!-- Divider -->
                        <View
                            android:id="@+id/divider_lineups"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="@color/surface_elevated" />

                        <!-- Home Section -->
                        <TextView
                            android:id="@+id/tv_home_lineup_team"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/mlb_red"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:paddingBottom="4dp"
                            tools:text="HOME" />

                        <!-- Batter table scrolls horizontally on its own -->
                        <HorizontalScrollView
                            android:id="@+id/scroll_home_lineup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <TableLayout
                                android:id="@+id/table_home_lineup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </HorizontalScrollView>

                        <!-- Pitcher table scrolls horizontally -->
                        <HorizontalScrollView
                            android:id="@+id/scroll_home_pitchers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:scrollbars="none">

                            <TableLayout
                                android:id="@+id/table_home_pitchers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </HorizontalScrollView>

                    </LinearLayout>

                    <!-- Plays Content -->
                    <LinearLayout
                        android:id="@+id/layout_plays_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- All / Scoring sub-tabs -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_tab_container"
                            android:padding="4dp"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/btn_plays_all"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:text="All"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="@drawable/bg_tab_selected" />

                            <TextView
                                android:id="@+id/btn_plays_scoring"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:text="Scoring"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="@android:color/transparent" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/container_plays"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Bullpen Usage Section ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_bullpen_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_bullpen_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BULLPEN USAGE (LAST 3 DAYS)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <ImageView
                            android:id="@+id/iv_bullpen_expand"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_bullpen_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/container_bullpen_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Pitch Types Section ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_pitch_types"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_pitch_types_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PITCH TYPES"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <ImageView
                            android:id="@+id/iv_pitch_types_expand"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_pitch_types_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/container_pitcher_types"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Game Info Card ─────────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_game_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_game_info_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GAME INFO"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"  android:paddingBottom="12dp" />

                    <GridLayout
                        android:id="@+id/grid_game_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header" />

</androidx.constraintlayout.widget.ConstraintLayout>
